++++        AddRamp("Ramp30", new Vector2(-12f, 8f), -30f, rampMat);
++++
++++        // Stairs: 8 steps, 0.25m rise each
++++        var stairs = new GameObject("Stairs");
++++        for (int i = 0; i < 8; i++)
