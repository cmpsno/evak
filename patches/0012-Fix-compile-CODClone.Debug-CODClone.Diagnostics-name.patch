diff --git a/Assets/Editor/BuildSocialClub.cs b/Assets/Editor/BuildSocialClub.cs
index 4003be4..5d2e857 100644
--- a/Assets/Editor/BuildSocialClub.cs
+++ b/Assets/Editor/BuildSocialClub.cs
@@ -46,7 +46,7 @@ public static class BuildSocialClub
