-        player.AddComponent<CODClone.Debug.DebugInputProbe>(); // TEMP: input diagnosis, delete before ship
+        player.AddComponent<CODClone.Diagnostics.DebugInputProbe>(); // TEMP: input diagnosis, delete before ship
 
