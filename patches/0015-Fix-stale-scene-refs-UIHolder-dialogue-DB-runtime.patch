From 44b321962153ecf97935610012a3138cf48ce2bc Mon Sep 17 00:00:00 2001
From: marvin <marvin@local>
Date: Mon, 21 Sep 2026 00:19:26 -0400
Subject: [PATCH] Fix stale scene refs: strip editor-only UIHolder,
 runtime-build dialogue DB

- BuildSocialClub: DestroyImmediate(holder) at end of BuildEpisodeSystems so
  the editor-only UIHolder MonoBehaviour never lands in the saved scene
  (was 'referenced script is missing' on DialogueUI in builds).
- BuildSocialClub: Configure(dialogue, null, ...) - stop embedding the
  code-generated DialogueDatabase ScriptableObject in the scene; its
  m_Script serialized as fileID 0, breaking dialogue content in builds.
- DialogueController.Awake: if database == null, build via
  Ep1DialogueBank.BuildDatabase() so dialogue never ships empty.
- SocialClub.unity: removed stale UIHolder component + orphan MonoScript
  stub (BuildSocialClub/UIHolder) + embedded DialogueDatabase sub-asset;
  nulled DialogueController.database (rebuilt at runtime).
---
 Assets/Editor/BuildSocialClub.cs              |     9 +-
 .../Data/PlayerInputActions.inputactions      |    82 +-
 Assets/_Project/Scenes/SocialClub.unity       |  4631 +++--
 .../Scripts/Dialogue/DialogueController.cs    |     4 +
 ...-decoupled-dialogue-per-episode-prof.patch | 15506 ++++++++++++++++
 ...ve-stale-CODClone.UI-using-DialogueU.patch |   887 +
 ...g-alias-in-DebugInputProbe-namespace.patch |   314 +
 ...lone.Debug-CODClone.Diagnostics-name.patch |   267 +
 ...ve-stale-CODClone.UI-using-in-BuildS.patch |   646 +
 ...Campusano.Interaction-using-for-Inte.patch |   235 +
 socialclub-webgl8.log                         |  6429 +++++++
 11 files changed, 26533 insertions(+), 2477 deletions(-)
 create mode 100644 patches/0009-TICKET-EP1-01-v2-decoupled-dialogue-per-episode-prof.patch
 create mode 100644 patches/0010-Fix-compile-remove-stale-CODClone.UI-using-DialogueU.patch
 create mode 100644 patches/0011-Fix-compile-Debug-alias-in-DebugInputProbe-namespace.patch
 create mode 100644 patches/0012-Fix-compile-CODClone.Debug-CODClone.Diagnostics-name.patch
 create mode 100644 patches/0013-Fix-compile-remove-stale-CODClone.UI-using-in-BuildS.patch
 create mode 100644 patches/0014-Fix-compile-add-Campusano.Interaction-using-for-Inte.patch
 create mode 100644 socialclub-webgl8.log

diff --git a/Assets/Editor/BuildSocialClub.cs b/Assets/Editor/BuildSocialClub.cs
index f63632c..34c6529 100644
--- a/Assets/Editor/BuildSocialClub.cs
+++ b/Assets/Editor/BuildSocialClub.cs
@@ -260,8 +260,10 @@ public static class BuildSocialClub
 
         var dialogueGO = new GameObject("DialogueController");
         var dialogue = dialogueGO.AddComponent<Campusano.Dialogue.DialogueController>();
-        dialogue.Configure(Campusano.Dialogue.Ep1DialogueBank.BuildDatabase(),
-                           holder.view, playerInputProvider);
+        // DB is built at runtime in DialogueController.Awake; embedding the
+        // code-generated ScriptableObject in the scene left a stale script ref
+        // (m_Script fileID 0) that broke dialogue in builds.
+        dialogue.Configure(null, holder.view, playerInputProvider);
 
         var routerGO = new GameObject("ChoiceRouter");
         var router = routerGO.AddComponent<Campusano.Missions.ChoiceRouter>();
@@ -280,6 +282,9 @@ public static class BuildSocialClub
         // Trigger volumes: hallway doorway (M1-S8) and back-room door (M2-S1).
         AddTriggerVolume("Vol_HallwayDoor", new Vector3(2f, 1f, 9f), new Vector3(2f, 3f, 1f));
         AddTriggerVolume("Vol_BackRoomDoor", new Vector3(9f, 1f, 12f), new Vector3(1f, 3f, 2f));
+
+        // UIHolder is editor-only: strip it so the saved scene has no dangling script ref.
+        GameObject.DestroyImmediate(holder);
     }
 
     static Campusano.Missions.StepTrigger[] BuildEp1Triggers()
