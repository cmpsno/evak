--- !u!114 &282268580
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 0}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp:Campusano.Dialogue:DialogueDatabase
  speakers:
  - {fileID: 1015641782}
  - {fileID: 219081880}
  - {fileID: 97026486}
  - {fileID: 1535897117}
  - {fileID: 1750810018}
  nodes:
  - nodeId: C_First_Talk
    presentation: 0
    lines:
    - speakerId: c
      text: Look who it is. The kid who didn't rat.
      voiceClip: {fileID: 0}
      autoAdvance: 0
      autoAdvanceDelay: 0
    - speakerId: c
      text: I got a job for you. Guy named Mook owes me two grand. He's late.
      voiceClip: {fileID: 0}
      autoAdvance: 0
      autoAdvanceDelay: 0
    - speakerId: nicky
      text: Two grand? That's a lot of faith for a kid.
      voiceClip: {fileID: 0}
      autoAdvance: 0
      autoAdvanceDelay: 0
    - speakerId: c
      text: Go collect it. Back room, card game. You know where to find him.
      voiceClip: {fileID: 0}
      autoAdvance: 0
      autoAdvanceDelay: 0
    choices: []
    nextNodeId: 
  - nodeId: mook_choice
    presentation: 0
    lines:
    - speakerId: mook
      text: C sent a kid? He must really be desperate.
      voiceClip: {fileID: 0}
      autoAdvance: 0
      autoAdvanceDelay: 0
    - speakerId: nicky
      text: He sent me to collect. Two grand, Mook.
      voiceClip: {fileID: 0}
      autoAdvance: 0
      autoAdvanceDelay: 0
    - speakerId: mook
      text: And if I say no?
      voiceClip: {fileID: 0}
      autoAdvance: 0
      autoAdvanceDelay: 0
    choices:
    - choiceId: intimidate
      choiceText: Intimidate him.
      resultNodeId: mook_intimidate
    - choiceId: private_convo
      choiceText: Ask for a private word.
      resultNodeId: mook_private
    nextNodeId: 
  - nodeId: mook_intimidate
    presentation: 0
    lines:
    - speakerId: nicky
      text: Then I tell C you said no. And you know how that ends.
      voiceClip: {fileID: 0}
      autoAdvance: 0
      autoAdvanceDelay: 0
    - speakerId: mook
      text: You got a mouth on you, kid.
      voiceClip: {fileID: 0}
      autoAdvance: 0
      autoAdvanceDelay: 0
    choices: []
    nextNodeId: knife_pull
  - nodeId: mook_private
    presentation: 0
    lines:
    - speakerId: nicky
      text: Walk with me. Away from your friends.
      voiceClip: {fileID: 0}
      autoAdvance: 0
      autoAdvanceDelay: 0
    - speakerId: mook
      text: ...Fine. But this better be good.
      voiceClip: {fileID: 0}
      autoAdvance: 0
      autoAdvanceDelay: 0
    choices: []
    nextNodeId: knife_pull
  - nodeId: knife_pull
    presentation: 0
    lines:
    - speakerId: narrator
      text: Mook's hand moves under the table. Steel catches the light.
      voiceClip: {fileID: 0}
      autoAdvance: 1
      autoAdvanceDelay: 2
    - speakerId: mook
      text: Nobody takes my money, kid.
      voiceClip: {fileID: 0}
      autoAdvance: 0
      autoAdvanceDelay: 0
    choices: []
    nextNodeId: 
  - nodeId: C_Aftermath
    presentation: 0
    lines:
    - speakerId: c
      text: It's done, then. Mook won't be late again.
      voiceClip: {fileID: 0}
      autoAdvance: 0
      autoAdvanceDelay: 0
    - speakerId: nicky
      text: It didn't have to go like that.
      voiceClip: {fileID: 0}
      autoAdvance: 0
      autoAdvanceDelay: 0
    - speakerId: c
      text: It always goes like that. Here's your cut.
      voiceClip: {fileID: 0}
      autoAdvance: 0
      autoAdvanceDelay: 0
    choices: []
    nextNodeId: 
  - nodeId: father_question
    presentation: 0
    lines:
    - speakerId: father
      text: You were out late. Where were you?
      voiceClip: {fileID: 0}
      autoAdvance: 0
      autoAdvanceDelay: 0
    - speakerId: nicky
      text: Around.
      voiceClip: {fileID: 0}
      autoAdvance: 0
      autoAdvanceDelay: 0
    - speakerId: father
      text: Don't lie to me, son. Was it him? Was it C?
      voiceClip: {fileID: 0}
      autoAdvance: 0
      autoAdvanceDelay: 0
    choices:
    - choiceId: lie
      choiceText: Lie to him.
      resultNodeId: father_lie
    - choiceId: truth
      choiceText: Tell the truth.
      resultNodeId: father_truth
    - choiceId: resignation
      choiceText: Say nothing. Walk away.
      resultNodeId: father_resignation
    nextNodeId: 
  - nodeId: father_lie
    presentation: 0
    lines:
    - speakerId: nicky
      text: It was nothing. Just cards with the guys.
      voiceClip: {fileID: 0}
      autoAdvance: 0
      autoAdvanceDelay: 0
    choices: []
    nextNodeId: 
  - nodeId: father_truth
    presentation: 0
    lines:
    - speakerId: nicky
      text: It was C. I did a job for him.
      voiceClip: {fileID: 0}
      autoAdvance: 0
      autoAdvanceDelay: 0
    choices: []
    nextNodeId: 
  - nodeId: father_resignation
    presentation: 0
    lines:
    - speakerId: narrator
      text: Nicky says nothing. The door closes behind him.
      voiceClip: {fileID: 0}
      autoAdvance: 1
      autoAdvanceDelay: 2
    choices: []
    nextNodeId: 
  - nodeId: C_Repeat
    presentation: 0
    lines:
    - speakerId: c
      text: Go handle it, kid.
      voiceClip: {fileID: 0}
      autoAdvance: 0
      autoAdvanceDelay: 0
    choices: []
    nextNodeId: 
